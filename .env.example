# Optional runtime settings. Do not put API keys in this file.
AQI_LIVE_CACHE_SECONDS=900
AQI_PAST_DAYS=2
AQI_FORECAST_DAYS=4
# AQI_DATABASE_PATH=data/air_quality.sqlite
# For a managed PostgreSQL or MySQL database, set DATABASE_URL instead.
# Keep the real value in secrets, never this file.
# DATABASE_URL=postgresql://user:password@host:5432/airquality?sslmode=require
# DATABASE_URL=mysql://user:password@host:3306/airquality?ssl_ca=/path/to/ca.pem
# Collector location list is JSON. Example with Delhi and Mumbai:
# AQI_COLLECTOR_LOCATIONS=[{"name":"Delhi","admin1":"Delhi","country":"India","latitude":28.6139,"longitude":77.2090},{"name":"Mumbai","admin1":"Maharashtra","country":"India","latitude":19.0760,"longitude":72.8777}]
# Optional scheduled AQI email alerts (STARTTLS SMTP). Add these as GitHub
# Actions secrets and to the dashboard host if users will subscribe there.
# AQI_SMTP_HOST=smtp.example.com
# AQI_SMTP_PORT=587
# AQI_SMTP_USER=your-smtp-user
# AQI_SMTP_PASSWORD=your-smtp-password
# AQI_ALERT_FROM=air-quality@example.com
# AQI_GEOCODE_URL=https://geocoding-api.open-meteo.com/v1/search
# AQI_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality

# Optional approved official-monitor connector. The endpoint must return JSON:
# {"station_name":"...", "aqi":123, "observed_at":"...", "distance_km":1.2}
# CPCB_AQI_URL=https://your-approved-monitor-service.example/current
